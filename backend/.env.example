# StockSentinel AI - Backend Environment Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./stocksentinel.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
CONSECUTIVE_ZERO_THRESHOLD=3
MAX_FINDINGS_PER_STORE=20
LOG_LEVEL=INFO

# OmniRoute AI Gateway Configuration (Groq / gpt-oss-120b)
OMNIROUTE_ENABLED=true
OMNIROUTE_API_BASE=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=gpt-oss-120b
OMNIROUTE_API_KEY=your_omniroute_api_key_here
