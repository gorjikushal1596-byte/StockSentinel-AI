# StockSentinel AI - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# Do not commit real credentials or production secrets.

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Application Base URL
VITE_APP_BASE_URL=http://localhost:5173

# Optional: Remote Telemetry Endpoint (defaults to client-side in-memory simulation when unset)
VITE_TELEMETRY_API_ENDPOINT=

# Optional: Model / Anomaly Scoring Service URL (defaults to deterministic client-side Poisson engine)
VITE_ANOMALY_ENGINE_URL=

# Feature Toggles
VITE_ENABLE_3D_PROCEDURAL_MODE=true
VITE_ENABLE_PERFORMANCE_MONITORING=false
